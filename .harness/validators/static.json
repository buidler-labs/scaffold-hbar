{
  "name": "tokenise-subscriptions-extend-static",
  "description": "Static acceptance for the Subscription Guide extension on a scaffolded tokenise-subscriptions app (template.json is removed by create-scaffold-hbar). Baseline app health is checked separately via baseline.",
  "jsonAssertions": [
    {
      "file": "package.json",
      "path": "packageManager",
      "equals": "yarn@3.2.3"
    },
    {
      "file": "package.json",
      "path": "scripts.harness:run",
      "equals": "hedera-harness run .harness/spec.yaml"
    },
    {
      "file": "package.json",
      "path": "devDependencies.hedera-harness",
      "equals": "1.2.0"
    },
    {
      "file": "package.json",
      "path": "workspaces.packages",
      "equals": ["packages/hardhat", "packages/nextjs"]
    }
  ],
  "fileAssertions": {
    "required": [
      "README.md",
      "AGENTS.md",
      "package.json",
      "packages/nextjs/package.json",
      "packages/hardhat/package.json",
      "packages/nextjs/app/page.tsx",
      "packages/nextjs/components/Header.tsx",
      "packages/nextjs/app/guide/page.tsx",
      "packages/hardhat/contracts/SubscriptionNFT.sol",
      "packages/hardhat/contracts/interfaces/IHederaTokenService.sol",
      ".harness/spec.yaml",
      ".harness/prd.md"
    ],
    "forbidden": [
      ".env",
      "packages/nextjs/.env",
      "packages/foundry"
    ]
  },
  "textAssertions": [
    {
      "file": "packages/nextjs/app/guide/page.tsx",
      "contains": [
        "How subscription NFTs work on Hedera",
        "Rental marketplace",
        "Sales marketplace",
        "HTS tokenization"
      ]
    },
    {
      "file": "packages/nextjs/components/Header.tsx",
      "contains": ["/guide"]
    },
    {
      "file": "packages/hardhat/contracts/SubscriptionNFT.sol",
      "contains": [
        "IHederaTokenService",
        "DEFAULT_HTS",
        "0x0000000000000000000000000000000000000167"
      ]
    },
    {
      "file": "packages/hardhat/contracts/interfaces/IHederaTokenService.sol",
      "contains": ["0x167", "createNonFungibleToken", "mintToken"]
    },
    {
      "file": "README.md",
      "contains": ["yarn install", "yarn next:dev", "yarn harness:run"]
    }
  ]
}
