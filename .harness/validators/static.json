{
  "name": "cross-chain-dca-extend-static",
  "description": "Static acceptance for the Cross-Chain Flow extension on a scaffolded cross-chain-dca app (template.json is removed by create-scaffold-hbar). Baseline app health is checked separately via baseline.",
  "jsonAssertions": [
    {
      "file": "package.json",
      "path": "packageManager",
      "equals": "yarn@3.2.3"
    },
    {
      "file": "package.json",
      "path": "scripts.harness:run",
      "equals": "hedera-harness run .harness/spec.yaml"
    },
    {
      "file": "package.json",
      "path": "devDependencies.hedera-harness",
      "equals": "1.2.0"
    },
    {
      "file": "package.json",
      "path": "workspaces.packages",
      "equals": ["packages/hardhat", "packages/nextjs"]
    }
  ],
  "fileAssertions": {
    "required": [
      "README.md",
      "AGENTS.md",
      "package.json",
      "packages/nextjs/package.json",
      "packages/hardhat/package.json",
      "packages/nextjs/app/page.tsx",
      "packages/nextjs/app/dca/page.tsx",
      "packages/nextjs/components/Header.tsx",
      "packages/nextjs/app/flow/page.tsx",
      "packages/hardhat/contracts/hedera/DcaOrchestrator.sol",
      "packages/hardhat/contracts/hedera/AxelarMessageSender.sol",
      "packages/hardhat/contracts/sepolia/AxelarMessageReceiver.sol",
      "packages/hardhat/contracts/sepolia/DcaExecutor.sol",
      ".harness/spec.yaml",
      ".harness/prd.md"
    ],
    "forbidden": [
      ".env",
      "packages/nextjs/.env",
      "packages/foundry"
    ]
  },
  "textAssertions": [
    {
      "file": "packages/nextjs/app/flow/page.tsx",
      "contains": [
        "How cross-chain DCA flows on Hedera",
        "Hedera orchestration",
        "Axelar GMP",
        "Sepolia execution"
      ]
    },
    {
      "file": "packages/nextjs/components/Header.tsx",
      "contains": ["/flow"]
    },
    {
      "file": "packages/hardhat/contracts/hedera/AxelarMessageSender.sol",
      "contains": [
        "IAxelarGateway",
        "payNativeGasForContractCall",
        "callContract"
      ]
    },
    {
      "file": "packages/hardhat/contracts/hedera/DcaOrchestrator.sol",
      "contains": [
        "0x16b",
        "scheduleCall",
        "hasScheduleCapacity",
        "bridgeSender"
      ]
    },
    {
      "file": "packages/hardhat/contracts/sepolia/AxelarMessageReceiver.sol",
      "contains": ["AxelarExecutable", "_execute", "expectedSourceChain"]
    },
    {
      "file": "README.md",
      "contains": ["yarn install", "yarn next:dev", "yarn harness:run"]
    }
  ]
}
