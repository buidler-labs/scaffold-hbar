{
  "name": "payments-scheduler-extend-static",
  "description": "Static acceptance for the DCA Explainer extension on a scaffolded payments-scheduler app (template.json is removed by create-scaffold-hbar). Baseline app health is checked separately via extend.baseline.",
  "jsonAssertions": [
    {
      "file": "package.json",
      "path": "packageManager",
      "equals": "yarn@3.2.3"
    },
    {
      "file": "package.json",
      "path": "scripts.harness:extend",
      "equals": "hedera-harness extend .harness/spec.yaml"
    },
    {
      "file": "package.json",
      "path": "devDependencies.hedera-harness",
      "equals": "1.1.1"
    },
    {
      "file": "package.json",
      "path": "workspaces.packages",
      "equals": ["packages/nextjs", "packages/foundry"]
    }
  ],
  "fileAssertions": {
    "required": [
      "README.md",
      "AGENTS.md",
      "package.json",
      "packages/nextjs/package.json",
      "packages/foundry/package.json",
      "packages/nextjs/app/page.tsx",
      "packages/nextjs/components/Header.tsx",
      "packages/nextjs/app/dca-guide/page.tsx",
      "packages/foundry/contracts/ScheduledVault.sol",
      "packages/foundry/contracts/interfaces/IHederaScheduleService.sol",
      ".harness/spec.yaml",
      ".harness/prd.md"
    ],
    "forbidden": [
      ".env",
      "packages/nextjs/.env",
      "packages/hardhat"
    ]
  },
  "textAssertions": [
    {
      "file": "packages/nextjs/app/dca-guide/page.tsx",
      "contains": [
        "How DCA scheduling works on Hedera",
        "ScheduledVault",
        "Hedera Schedule Service (HSS)",
        "DCA strategy pattern"
      ]
    },
    {
      "file": "packages/nextjs/components/Header.tsx",
      "contains": ["/dca-guide"]
    },
    {
      "file": "packages/foundry/contracts/ScheduledVault.sol",
      "contains": [
        "IHederaScheduleService",
        "scheduleCall",
        "0x000000000000000000000000000000000000016B"
      ]
    },
    {
      "file": "packages/foundry/contracts/interfaces/IHederaScheduleService.sol",
      "contains": ["0x16b", "scheduleCall", "deleteSchedule", "hasScheduleCapacity"]
    },
    {
      "file": "README.md",
      "contains": ["yarn install", "yarn next:dev", "yarn harness:extend"]
    }
  ]
}
