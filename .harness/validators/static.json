{
  "name": "hedera-demo-static",
  "description": "Static acceptance for the Learn-page extension on a scaffolded hedera-demo app (template.json is removed by create-scaffold-hbar). Baseline app health is checked separately via extend.baseline.",
  "jsonAssertions": [
    {
      "file": "package.json",
      "path": "workspaces.packages",
      "equals": ["packages/nextjs"]
    },
    {
      "file": "package.json",
      "path": "packageManager",
      "equals": "yarn@3.2.3"
    },
    {
      "file": "package.json",
      "path": "scripts.harness:run",
      "equals": "hedera-harness run .harness/spec.yaml"
    },
    {
      "file": "package.json",
      "path": "devDependencies.hedera-harness",
      "equals": "1.1.1"
    }
  ],
  "fileAssertions": {
    "required": [
      "README.md",
      "AGENTS.md",
      "package.json",
      "packages/nextjs/package.json",
      "packages/nextjs/app/page.tsx",
      "packages/nextjs/components/Header.tsx",
      "packages/nextjs/app/learn/page.tsx",
      ".harness/spec.yaml",
      ".harness/prd.md"
    ],
    "forbidden": [
      ".env",
      "packages/nextjs/.env",
      "packages/hardhat",
      "packages/foundry"
    ]
  },
  "textAssertions": [
    {
      "file": "packages/nextjs/app/learn/page.tsx",
      "contains": [
        "How this demo uses Hedera",
        "Consensus Service (HCS)",
        "Token Service (HTS)"
      ]
    },
    {
      "file": "packages/nextjs/components/Header.tsx",
      "contains": ["/learn"]
    },
    {
      "file": "README.md",
      "contains": ["yarn install", "yarn next:dev", "yarn harness:run"]
    }
  ]
}
