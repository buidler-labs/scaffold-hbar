{
  "name": "hedera-demo-yarn",
  "description": "Yarn-only target validation after the Learn-page extension. Named install allows fingerprint skip across attempts.",
  "requiresNoSecrets": true,
  "forbiddenCommands": [
    "npm install",
    "npm run",
    "pnpm install",
    "pnpm run",
    "yarn hardhat:*",
    "yarn foundry:*",
    "docker *"
  ],
  "commands": [
    {
      "name": "install",
      "command": "yarn install",
      "timeoutMs": 300000,
      "purpose": "Install the Next.js workspace with Yarn (pilot is yarn-only)."
    },
    {
      "name": "lint",
      "command": "yarn lint",
      "timeoutMs": 180000,
      "purpose": "Lint the extended frontend."
    },
    {
      "name": "build",
      "command": "yarn next:build",
      "timeoutMs": 300000,
      "purpose": "Production build (includes TypeScript checks)."
    }
  ]
}
