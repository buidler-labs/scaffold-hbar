# Hedera testnet
HEDERA_RPC_URL=https://testnet.hashio.io/api
HEDERA_PRIVATE_KEY=0x...your_hedera_evm_private_key
HEDERA_CHAIN_ID=296

# Sepolia
SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY
SEPOLIA_PRIVATE_KEY=0x...your_sepolia_private_key
SEPOLIA_CHAIN_ID=11155111
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_API_KEY

# Axelar — Hedera side
# Axelar Gateway on Hedera testnet
AXELAR_GATEWAY_HEDERA=0xe432150cce91c13a887f7D836923d5597adD8E31
# Axelar Gas Service on Hedera testnet
AXELAR_GAS_SERVICE_HEDERA=0xbE406F0189A0B4cf3A05C286473D23791Dd44Cc6
# Axelar chain name for the destination (Sepolia)
AXELAR_DESTINATION_CHAIN_NAME=ethereum-sepolia

# Axelar — Sepolia side
# Axelar Gateway on Sepolia
AXELAR_GATEWAY_SEPOLIA=0xe432150cce91c13a887f7D836923d5597adD8E31
# Axelar chain name for the source (Hedera)
AXELAR_SOURCE_CHAIN_NAME=hedera

# Sepolia token addresses
# Circle USDC on Sepolia — get from https://faucet.circle.com/
USDC_ADDRESS=0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238
# Uniswap v3 SwapRouter on Sepolia
UNISWAP_ROUTER=0x65669fE35312947050C450Bd5d36e6361F85eC12

# Optional: funding amounts
ORCHESTRATOR_FUND_AMOUNT=10
FUND_USDC_AMOUNT=5
