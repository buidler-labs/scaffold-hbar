{
  "name": "@sh/cross-chain-dca",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "hedera:compile": "hardhat compile --config hedera-orchestrator/hardhat.config.ts",
    "hedera:test": "hardhat test --config hedera-orchestrator/hardhat.config.ts",
    "hedera:deploy": "hardhat run hedera-orchestrator/scripts/deploy.ts --config hedera-orchestrator/hardhat.config.ts --network hedera-testnet",
    "hedera:wire": "hardhat run hedera-orchestrator/scripts/wire.ts --config hedera-orchestrator/hardhat.config.ts --network hedera-testnet",
    "hedera:plan:create": "hardhat run hedera-orchestrator/scripts/create-plan.ts --config hedera-orchestrator/hardhat.config.ts --network hedera-testnet",
    "hedera:plan:cancel": "hardhat run hedera-orchestrator/scripts/cancel-plan.ts --config hedera-orchestrator/hardhat.config.ts --network hedera-testnet",
    "hedera:plan:latest": "hardhat run hedera-orchestrator/scripts/latest-plan.ts --config hedera-orchestrator/hardhat.config.ts --network hedera-testnet",
    "hedera:fund": "hardhat run hedera-orchestrator/scripts/fund-orchestrator.ts --config hedera-orchestrator/hardhat.config.ts --network hedera-testnet",
    "hedera:withdraw:orchestrator": "hardhat run hedera-orchestrator/scripts/withdraw-orchestrator.ts --config hedera-orchestrator/hardhat.config.ts --network hedera-testnet",
    "hedera:withdraw:sender": "hardhat run hedera-orchestrator/scripts/withdraw-sender.ts --config hedera-orchestrator/hardhat.config.ts --network hedera-testnet",
    "sepolia:compile": "hardhat compile --config sepolia-executor/hardhat.config.ts",
    "sepolia:test": "hardhat test --config sepolia-executor/hardhat.config.ts",
    "sepolia:deploy": "hardhat run sepolia-executor/scripts/deploy.ts --config sepolia-executor/hardhat.config.ts --network sepolia",
    "sepolia:wire": "hardhat run sepolia-executor/scripts/wire.ts --config sepolia-executor/hardhat.config.ts --network sepolia",
    "sepolia:verify": "hardhat run sepolia-executor/scripts/verify.ts --config sepolia-executor/hardhat.config.ts --network sepolia",
    "sepolia:fund:usdc": "hardhat run sepolia-executor/scripts/fund-usdc.ts --config sepolia-executor/hardhat.config.ts --network sepolia",
    "sepolia:balance:check": "hardhat run sepolia-executor/scripts/balance-check.ts --config sepolia-executor/hardhat.config.ts --network sepolia",
    "sepolia:withdraw:executor": "hardhat run sepolia-executor/scripts/withdraw-executor.ts --config sepolia-executor/hardhat.config.ts --network sepolia",
    "sepolia:withdraw:receiver": "hardhat run sepolia-executor/scripts/withdraw-receiver.ts --config sepolia-executor/hardhat.config.ts --network sepolia",
    "deploy": "bash scripts/deploy-all.sh"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-chai-matchers": "^2.0.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "@nomicfoundation/hardhat-ignition": "^0.15.16",
    "@nomicfoundation/hardhat-ignition-ethers": "^0.15.0",
    "@nomicfoundation/hardhat-network-helpers": "^1.0.0",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "@nomicfoundation/hardhat-verify": "^2.0.0",
    "@nomicfoundation/ignition-core": "^0.15.15",
    "@typechain/ethers-v6": "^0.5.0",
    "@typechain/hardhat": "^9.0.0",
    "@types/chai": "^4.2.0",
    "@types/mocha": ">=9.1.0",
    "@types/node": "^20.11.0",
    "chai": "^4.2.0",
    "hardhat": "^2.22.0",
    "hardhat-gas-reporter": "^1.0.8",
    "prettier": "^3.8.3",
    "solidity-coverage": "^0.8.1",
    "ts-node": "^10.9.2",
    "typechain": "^8.3.0",
    "typescript": "^5.3.0"
  },
  "dependencies": {
    "@axelar-network/axelar-gmp-sdk-solidity": "^6.1.0",
    "@openzeppelin/contracts": "^5.6.1",
    "dotenv": "^16.4.0"
  }
}
