# Template for Foundry environment variables.
#
# Copy this file to `.env`, then uncomment and fill only the values needed for
# the flow you are running. Keep placeholder addresses commented until you have
# real deployed addresses.

# ---------------------------------------------------------------------------
# Shared RPC and account settings
# ---------------------------------------------------------------------------

# Hedera JSON-RPC endpoints used by Foundry rpc_endpoints aliases.
HEDERA_TESTNET_RPC_URL=https://testnet.hashio.io/api
HEDERA_MAINNET_RPC_URL=https://mainnet.hashio.io/api

# Sepolia RPC used by Axelar / CCIP / LayerZero scripts.
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/${ALCHEMY_API_KEY}

# Foundry keystore alias. Replace this with your imported/generated account.
ACCOUNT=your_cast_alias

# Optional: explicitly set deployer EOA and skip `cast wallet address`.
# EOA=0x...

# Default account for localhost. Use "scaffold-hbar-custom" for a generated or imported Scaffold-HBAR account.
LOCALHOST_KEYSTORE_ACCOUNT=scaffold-hbar-default

# ---------------------------------------------------------------------------
# Axelar ITS - token deployment settings
# ---------------------------------------------------------------------------

# Token metadata used by axelar-deploy-hedera and remote Sepolia deployment.
# AXELAR_TOKEN_NAME=BridgeToken
# AXELAR_TOKEN_SYMBOL=BTK
# AXELAR_TOKEN_DECIMALS=8

# Hedera ITS-created HTS token minter. Defaults to EOA. Keep this nonzero
# while learning if you want to run the testnet mint helpers.
# Set SEPOLIA_REMOTE_MINTER=0x0000000000000000000000000000000000000000
# to deploy the remote Sepolia token without a testnet minter.
# HEDERA_ITS_MINTER=0x...
# SEPOLIA_REMOTE_MINTER=0x...

# Hedera ITS-created HTS token creation funding and gas settings.
# HEDERA_WHBAR_DEPOSIT_VALUE is JSON-RPC wei-style HBAR and defaults to
# tokenCreationPriceTinybars * 10^10.
# HEDERA_WHBAR_DEPOSIT_VALUE=
# HEDERA_WHBAR_ALLOWANCE=
# HEDERA_TOKEN_CREATION_PRICE_TINYBARS=
# HEDERA_WHBAR_ADDRESS=
# HEDERA_DEPLOY_GAS_LIMIT=15000000
# HEDERA_TRANSFER_GAS_LIMIT=15000000
# HEDERA_GAS_PRICE_WEI=

# ---------------------------------------------------------------------------
# Axelar ITS - addresses filled after deployment
# ---------------------------------------------------------------------------

# Deploy helpers record these in deployments/bridge/axelar.json. Uncomment only
# when you want to override or debug a step manually.
#
# Sepolia token address returned by ITS registeredTokenAddress(tokenId) after
# the remote deployment executes.
# SEPOLIA_BRIDGE_TOKEN=0x...

# Hedera HTS token address returned by ITS registeredTokenAddress(tokenId).
# HEDERA_BRIDGE_TOKEN=0x...

# ---------------------------------------------------------------------------
# Axelar ITS - remote deployment settings
# ---------------------------------------------------------------------------

# Native Hedera ITS flow deploys a remote interchain token to Sepolia.
# Defaults pay 50 HBAR because this message deploys a token contract on Sepolia.
# Axelar refunds excess gas after execution.
# HEDERA_REMOTE_DEPLOY_GAS_VALUE_ITS=5000000000
# HEDERA_REMOTE_DEPLOY_NATIVE_FEE_ITS=50000000000000000000

# Optional bytes32 override. axelar-deploy-hedera writes script/axelar/.salt.
# SALT=0x...

# ---------------------------------------------------------------------------
# Axelar ITS - fees
# ---------------------------------------------------------------------------

# Sepolia ITS messages. NATIVE_FEE_ITS must be >= GAS_VALUE_ITS.
# GAS_VALUE_ITS=0.0001ether
# NATIVE_FEE_ITS=0.001ether

# Hedera source-chain transfers use different units for Axelar gas payment:
# - HEDERA_SEND_GAS_VALUE_ITS is tinybar-style, as interpreted by Axelar GasService on Hedera.
# - HEDERA_SEND_NATIVE_FEE_ITS is JSON-RPC msg.value, 18-decimal wei-style HBAR.
# The defaults below pay 25 HBAR. Hedera -> Sepolia routes through ITS Hub and
# can fail final Sepolia execution if this is too low. Axelar refunds excess gas.
# HEDERA_SEND_GAS_VALUE_ITS=2500000000
# HEDERA_SEND_NATIVE_FEE_ITS=25000000000000000000

# Optional recovery value for make axelar-add-gas-hedera. Defaults to the
# Hedera send native fee above.
# HEDERA_ADD_GAS_NATIVE_FEE=25000000000000000000

# ---------------------------------------------------------------------------
# Axelar ITS - transfers
# ---------------------------------------------------------------------------

# Amount in smallest units. Example: 1 token at the Axelar default 8 decimals.
# AMOUNT=100000000

# Optional recipient. Defaults to deployer EOA.
# RECIPIENT=0x...

# ---------------------------------------------------------------------------
# LayerZero OFT - Chapter 1 Sepolia <-> Hedera simple-workers flow
# ---------------------------------------------------------------------------

# Token metadata used by layerzero-deploy-sepolia and layerzero-deploy-hedera.
# LAYERZERO_TOKEN_NAME=BridgeToken
# LAYERZERO_TOKEN_SYMBOL=BTK

# Initial supply minted to the deployer on Sepolia. 1 token at 18 decimals.
# LAYERZERO_PREMINT_SEPOLIA=1000000000000000000

# Hedera HTS connector deployment settings.
# HEDERA_HTS_CREATE_VALUE=40ether
# HEDERA_DEPLOY_GAS_LIMIT=15000000
# HEDERA_TRANSFER_GAS_LIMIT=15000000
# HEDERA_GAS_PRICE_WEI=

# Manual relay gas used by SimpleExecutorMock.commitAndExecute.
# LAYERZERO_RELAY_LZRECEIVE_GAS=500000

# The deploy helpers record bridge addresses in deployments/bridge/*.json and
# `make bridge-sync-next PROVIDER=<provider>` writes the Next.js config files.
# You can still uncomment these values to override a step manually while
# learning or debugging.
#
# LayerZero manual overrides:
# SEPOLIA_OFT=0x...
# HEDERA_OFT=0x...
# HEDERA_HTS_TOKEN=0x...
# SEPOLIA_WORKERS_DVN=0x...
# SEPOLIA_WORKERS_EXECUTOR=0x...
# HEDERA_WORKERS_DVN=0x...
# HEDERA_WORKERS_EXECUTOR=0x...

# ---------------------------------------------------------------------------
# CCIP CCT Burn & Mint - token deployment settings
# ---------------------------------------------------------------------------

# CCT Metadata
# CCIP_TOKEN_NAME=BestToken
# CCIP_TOKEN_SYMBOL=BTK
# CCIP_TOKEN_DECIMALS=8

# Initial supply minted to the deployer on each chain. 100 tokens at 8 decimals.
# CCIP_PREMINT_SEPOLIA=10000000000
# CCIP_PREMINT_HEDERA=10000000000

# ---------------------------------------------------------------------------
# CCIP CCT Burn & Mint - addresses filled after deployment
# ---------------------------------------------------------------------------

# Deploy helpers record these in deployments/bridge/ccip.json. Uncomment only
# when you want to override or debug a step manually.
#
# Sepolia deploy output.
# CCIP_SEPOLIA_TOKEN=0x...
# CCIP_SEPOLIA_POOL=0x...

# Hedera deploy output.
# CCIP_HEDERA_TOKEN=0x...
# CCIP_HEDERA_POOL=0x...
# CCIP_HEDERA_HTS_TOKEN=0x... # only for HTS-backed Hedera deploys

# ---------------------------------------------------------------------------
# CCIP CCT Burn & Mint - transfers
# ---------------------------------------------------------------------------

# Amount in smallest units. Example: 10 tokens at 8 decimals.
# AMOUNT=1000000000

# Optional recipient. Defaults to deployer EOA.
# RECIPIENT=0x...

# ---------------------------------------------------------------------------
# Verification
# ---------------------------------------------------------------------------

# forge verify-contract on Sepolia.
# ETHERSCAN_API_KEY=

# HashScan verification target for verify-hedera.
# VERIFY_HEDERA_NETWORK=testnet
