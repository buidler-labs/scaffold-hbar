{
  "name": "@sh/foundry",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "account": "make account",
    "account:generate": "node scripts-js/generateKeystore.js",
    "account:import": "node scripts-js/importAccount.js",
    "account:reveal-pk": "node scripts-js/revealPK.js",
    "clean": "forge clean",
    "compile": "make compile",
    "deploy": "node scripts-js/parseArgs.js",
    "deploy:consumer:testnet": "node scripts-js/parseArgs.js --file DeployOracleConsumer.s.sol --network hedera_testnet",
    "deploy:consumer:mainnet": "node scripts-js/parseArgs.js --file DeployOracleConsumer.s.sol --network hedera_mainnet",
    "deploy:chainlink:testnet": "node scripts-js/parseArgs.js --file DeployChainlinkOracle.s.sol --network hedera_testnet",
    "deploy:chainlink:mainnet": "node scripts-js/parseArgs.js --file DeployChainlinkOracle.s.sol --network hedera_mainnet",
    "deploy:supra:testnet": "node scripts-js/parseArgs.js --file DeploySupraOracle.s.sol --network hedera_testnet",
    "deploy:supra:mainnet": "node scripts-js/parseArgs.js --file DeploySupraOracle.s.sol --network hedera_mainnet",
    "deploy:pyth:testnet": "node scripts-js/parseArgs.js --file DeployPythOracle.s.sol --network hedera_testnet",
    "deploy:pyth:mainnet": "node scripts-js/parseArgs.js --file DeployPythOracle.s.sol --network hedera_mainnet",
    "flatten": "make flatten",
    "format": "make format",
    "lint": "make lint",
    "lint-staged": "yarn lint",
    "read:chainlink:testnet": "make read-chainlink-testnet",
    "read:chainlink:mainnet": "make read-chainlink-mainnet",
    "read:supra:testnet": "make read-supra-testnet",
    "read:supra:mainnet": "make read-supra-mainnet",
    "read:pyth:testnet": "node scripts-js/parseArgs.js --file ReadPythOracle.s.sol --network hedera_testnet --make-target run-script",
    "read:pyth:mainnet": "node scripts-js/parseArgs.js --file ReadPythOracle.s.sol --network hedera_mainnet --make-target run-script",
    "set-oracle:testnet": "node scripts-js/parseArgs.js --file SetConsumerOracle.s.sol --network hedera_testnet --make-target run-script",
    "set-oracle:mainnet": "node scripts-js/parseArgs.js --file SetConsumerOracle.s.sol --network hedera_mainnet --make-target run-script",
    "test": "forge test",
    "test:testnet": "forge test --fork-url ${HEDERA_RPC_URL:-https://testnet.hashio.io/api} --chain-id 296 --ffi",
    "test:mainnet": "forge test --fork-url https://mainnet.hashio.io/api --chain-id 295 --ffi",
    "test:chainlink:testnet": "make test-chainlink-testnet",
    "test:chainlink:mainnet": "make test-chainlink-mainnet",
    "test:supra:testnet": "make test-supra-testnet",
    "test:supra:mainnet": "make test-supra-mainnet",
    "test:pyth:testnet": "make test-pyth-testnet",
    "test:pyth:mainnet": "make test-pyth-mainnet",
    "verify:testnet": "forge verify-contract --chain-id 296 --verifier sourcify",
    "verify:mainnet": "forge verify-contract --chain-id 295 --verifier sourcify",
    "postinstall": "shx cp -n .env.example .env"
  },
  "dependencies": {
    "dotenv": "~16.3.1",
    "envfile": "~6.18.0",
    "ethers": "~5.7.1",
    "prettier": "~2.8.8",
    "qrcode": "~1.5.3",
    "toml": "~3.0.0"
  },
  "devDependencies": {
    "shx": "^0.3.4"
  }
}
