{
  "name": "x402-pay-per-use",
  "description": "Pay-per-download file marketplace on Hedera using x402. Private MinIO storage, self-hosted facilitator, FileRegistry on testnet.",
  "create-scaffold-hbar": {
    "capabilities": {
      "frontend": ["nextjs-app"],
      "solidityFramework": ["hardhat"],
      "packageManager": ["yarn", "npm"]
    },
    "defaults": {
      "frontend": "nextjs-app",
      "solidityFramework": "hardhat",
      "packageManager": "yarn"
    },
    "outro": {
      "sections": [
        {
          "steps": [
            {
              "text": "x402 pay-per-download marketplace: MinIO + self-hosted facilitator + FileRegistry on Hedera testnet."
            }
          ]
        },
        {
          "title": "Next steps",
          "steps": [
            {
              "label": "Copy environment files",
              "command": "cp .env.example .env"
            },
            {
              "command": "cp packages/nextjs/.env.example packages/nextjs/.env"
            },
            {
              "label": "Configure facilitator fee-payer (ECDSA) in root .env",
              "text": "Set FACILITATOR_ACCOUNT_ID and FACILITATOR_PRIVATE_KEY"
            },
            {
              "label": "Fund accounts with testnet HBAR",
              "url": "https://portal.hedera.com/faucet"
            },
            {
              "label": "Start local infra (MinIO + facilitator)",
              "command": "{run:infra:up}"
            },
            {
              "label": "Generate a deployer account",
              "command": "{run:hardhat:account:generate}"
            },
            {
              "label": "Deploy FileRegistry",
              "command": "{run:hardhat:deploy} --network hederaTestnet"
            },
            {
              "label": "Verify on Hashscan",
              "command": "{run:hardhat:verify:testnet}"
            },
            {
              "label": "Start the app",
              "command": "{run:next:dev}"
            },
            {
              "text": "See README.md and RUNBOOK.md for end-to-end verification and agent testing with {run:x402:buy}."
            }
          ]
        }
      ]
    }
  }
}
