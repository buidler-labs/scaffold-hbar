{
  "name": "oracles",
  "description": "Hedera oracle template with Foundry contracts and Chainlink, Supra, and Pyth adapters.",
  "create-scaffold-hbar": {
    "capabilities": {
      "frontend": ["nextjs-app"],
      "solidityFramework": ["foundry"]
    },
    "defaults": {
      "frontend": "nextjs-app",
      "solidityFramework": "foundry"
    },
    "outro": {
      "sections": [
        {
          "steps": [
            {
              "text": "This template uses Hedera oracle providers. Chainlink and Supra are push-style reads, while Pyth requires fresh update data before reading."
            }
          ]
        },
        {
          "title": "Suggested steps",
          "steps": [
            {
              "label": "Generate or import a deployer account",
              "command": "{run:foundry:account:generate}"
            },
            {
              "label": "Compile contracts",
              "command": "{run:foundry:compile}"
            },
            {
              "label": "Run unit tests",
              "command": "{run:foundry:test}"
            },
            {
              "label": "Run a provider fork smoke test",
              "command": "{run:foundry:test:chainlink:testnet}",
              "text": "Swap chainlink for supra or pyth as needed."
            },
            {
              "label": "Deploy an oracle adapter to Hedera testnet",
              "command": "{run:foundry:deploy:chainlink:testnet}",
              "text": "Swap chainlink for supra or pyth as needed."
            },
            {
              "label": "Deploy the demo consumer",
              "command": "ORACLE_ADAPTER_NAME=ChainlinkPriceOracleAdapter {run:foundry:deploy:consumer:testnet}"
            },
            {
              "label": "Read oracle prices",
              "command": "{run:foundry:read:chainlink:testnet}"
            },
            {
              "label": "Start the frontend",
              "command": "{run:next:dev}"
            },
            {
              "text": "After this, customize the supported pairs, provider config, contracts, or frontend to fit your product."
            }
          ]
        }
      ]
    }
  }
}
