{
  "name": "payments-scheduler",
  "description": "HTS payments scheduler template with Foundry contracts.",
  "create-scaffold-hbar": {
    "capabilities": {
      "frontend": ["nextjs-app"],
      "solidityFramework": ["foundry"]
    },
    "defaults": {
      "frontend": "nextjs-app",
      "solidityFramework": "foundry"
    },
    "outro": {
      "sections": [
        {
          "steps": [
            {
              "text": "This template uses Hedera Schedule Service, which is not yet available in Foundry Hedera forking, so run it on Hedera testnet or mainnet (not on a local chain or forked Hedera network)."
            }
          ]
        },
        {
          "title": "Suggested steps",
          "steps": [
            {
              "label": "Generate or import a deployer account",
              "command": "{run:foundry:account:generate}"
            },
            {
              "label": "Compile contracts",
              "command": "{run:foundry:compile}"
            },
            {
              "label": "Run tests",
              "command": "{run:foundry:test}"
            },
            {
              "label": "Deploy to Hedera testnet",
              "command": "{run:foundry:deploy:testnet}"
            },
            {
              "label": "Verify on Hashscan testnet",
              "command": "{run:foundry:verify:testnet}"
            },
            {
              "label": "Start the frontend",
              "command": "{run:next:dev}"
            },
            {
              "text": "After this, customize anything you want in contracts or frontend to fit your product."
            }
          ]
        }
      ]
    }
  }
}
