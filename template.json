{
  "name": "bridge",
  "description": "Hedera bridge starter template with Foundry contracts and Axelar ITS, Chainlink CCIP, and LayerZero OFT flows.",
  "create-scaffold-hbar": {
    "capabilities": {
      "frontend": [
        "nextjs-app"
      ],
      "solidityFramework": [
        "foundry"
      ]
    },
    "defaults": {
      "frontend": "nextjs-app",
      "solidityFramework": "foundry"
    },
    "outro": {
      "sections": [
        {
          "steps": [
            {
              "text": "This template is an educational bridge starter (Foundry + Axelar ITS, Chainlink CCIP, LayerZero OFT)."
            }
          ]
        },
        {
          "title": "Next steps",
          "steps": [
            {
              "label": "Generate or import a deployer account",
              "command": "{run:foundry:account:generate}"
            },
            {
              "label": "Fund the account before testnet deploy",
              "text": "Hedera testnet HBAR:",
              "url": "https://portal.hedera.com/faucet"
            },
            {
              "text": "Sepolia ETH:",
              "url": "https://sepolia-faucet.pk910.de/"
            },
            {
              "label": "Configure packages/foundry/.env",
              "text": "Set ACCOUNT, SEPOLIA_RPC_URL, and HEDERA_TESTNET_RPC_URL"
            },
            {
              "label": "Compile contracts",
              "command": "{run:foundry:compile}"
            },
            {
              "label": "Run unit tests",
              "command": "{run:foundry:test}"
            },
            {
              "label": "Choose one bridge provider and open its runbook",
              "command": "cd packages/foundry && make axelar-help"
            },
            {
              "command": "cd packages/foundry && make ccip-help"
            },
            {
              "command": "cd packages/foundry && make layerzero-help"
            },
            {
              "label": "Deploy and configure that provider",
              "text": "Follow packages/foundry/script/<provider>/README.md"
            },
            {
              "label": "Sync the deployed provider config into the frontend",
              "command": "cd packages/foundry && make bridge-sync-next PROVIDER=<provider>"
            },
            {
              "label": "Start the frontend",
              "command": "{run:next:dev}"
            },
            {
              "label": "Try a small test transfer",
              "text": "Connect a funded testnet wallet, select the configured provider, and send a transfer. Some Hedera HTS flows require receiver association before receiving."
            },
            {
              "text": "After this, customize provider config, contracts, UI, limits, fees, and operational controls to fit your product."
            }
          ]
        }
      ]
    }
  }
}
